<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="10dp">

                    <Button
                        android:id="@+id/mode_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/mode_3_player"
                        android:backgroundTint="@color/accent"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:paddingHorizontal="12dp"/>

                    <Button
                        android:id="@+id/reset_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/reset"
                        android:backgroundTint="@color/error"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:paddingHorizontal="12dp"
                        android:layout_marginStart="8dp"/>

                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card"
                    app:cardCornerRadius="8dp"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/player1_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/player1"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:gravity="center"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/player1_score"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="100"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:gravity="center"
                            android:layout_marginBottom="6dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <Button
                                android:id="@+id/player1_win"
                                android:layout_width="50dp"
                                android:layout_height="34dp"
                                android:text="@string/win"
                                android:backgroundTint="@color/success"
                                android:textColor="@color/white"
                                android:textSize="10sp"/>

                            <Button
                                android:id="@+id/player1_foul"
                                android:layout_width="50dp"
                                android:layout_height="34dp"
                                android:text="@string/foul"
                                android:backgroundTint="@color/error"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:layout_marginStart="8dp"/>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card"
                    app:cardCornerRadius="8dp"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/player2_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/player2"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:gravity="center"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/player2_score"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="100"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:gravity="center"
                            android:layout_marginBottom="6dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <Button
                                android:id="@+id/player2_win"
                                android:layout_width="50dp"
                                android:layout_height="34dp"
                                android:text="@string/win"
                                android:backgroundTint="@color/success"
                                android:textColor="@color/white"
                                android:textSize="10sp"/>

                            <Button
                                android:id="@+id/player2_foul"
                                android:layout_width="50dp"
                                android:layout_height="34dp"
                                android:text="@string/foul"
                                android:backgroundTint="@color/error"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:layout_marginStart="8dp"/>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/player3_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card"
                    app:cardCornerRadius="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/player3_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/player3"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:gravity="center"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/player3_score"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="100"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:gravity="center"
                            android:layout_marginBottom="6dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <Button
                                android:id="@+id/player3_win"
                                android:layout_width="50dp"
                                android:layout_height="34dp"
                                android:text="@string/win"
                                android:backgroundTint="@color/success"
                                android:textColor="@color/white"
                                android:textSize="10sp"/>

                            <Button
                                android:id="@+id/player3_foul"
                                android:layout_width="50dp"
                                android:layout_height="34dp"
                                android:text="@string/foul"
                                android:backgroundTint="@color/error"
                                android:textColor="@color/text_primary"
                                android:textSize="10sp"
                                android:layout_marginStart="8dp"/>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/selector_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#FF000000"
        android:visibility="gone">

            <TextView
                android:id="@+id/selector_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/select_target"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:textAlignment="center"
                android:layout_marginBottom="20dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/selector_player1"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:text="@string/player1"
                    android:backgroundTint="#FF00FF00"
                    android:textColor="#FF000000"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/selector_player2"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:text="@string/player2"
                    android:backgroundTint="#FF00FF00"
                    android:textColor="#FF000000"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"/>

                <Button
                    android:id="@+id/selector_player3"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:text="@string/player3"
                    android:backgroundTint="#FF00FF00"
                    android:textColor="#FF000000"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

            <Button
                android:id="@+id/selector_cancel"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="@string/cancel"
                android:backgroundTint="#FFFFFFFF"
                android:textColor="#FF000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/confirm_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="22dp"
        android:background="#FF000000"
        android:visibility="gone">

            <TextView
                android:id="@+id/confirm_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/confirm_reset"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:textAlignment="center"
                android:layout_marginBottom="25dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/confirm_ok"
                    android:layout_width="70dp"
                    android:layout_height="45dp"
                    android:text="@string/ok"
                    android:backgroundTint="#FF00FF00"
                    android:textColor="#FF000000"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/confirm_cancel"
                    android:layout_width="70dp"
                    android:layout_height="45dp"
                    android:text="@string/cancel"
                    android:backgroundTint="#FFFFFFFF"
                    android:textColor="#FF000000"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginStart="15dp"/>

            </LinearLayout>

    </LinearLayout>

</FrameLayout>
